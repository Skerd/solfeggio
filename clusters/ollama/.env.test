# Ollama cluster configuration (local LLM for the AI-assistant chat)
OLLAMA_HOST=ollama
OLLAMA_INTERNAL_PORT=11434
OLLAMA_EXTERNAL_PORT=11434
OLLAMA_IMAGE=ollama/ollama:latest

# Model tag to pull on startup and serve to the assistant brain.
# Qwen3.6-35B-A3B: MoE, 35B total but only ~3B active per token, so it runs at
# usable speed on a CPU-only host where a dense model of the same size would not.
OLLAMA_MODEL=qwen3.6:35b

# Lighter model for the public visitor chat (AI_ASSISTANT_MODEL_LIGHT).
# Blank reuses OLLAMA_MODEL.
OLLAMA_MODEL_LIGHT=gpt-oss:20b

# CPU tuning. 0 = let Ollama choose the thread count; on a CPU-only host set it
# from `llama-bench` — token generation is memory-bandwidth bound and peaks well
# below the physical core count.
OLLAMA_NUM_THREAD=0
OLLAMA_CONTEXT_LENGTH=16384

# Optional generation tuning surfaced into the Maestro .env when enabled.
# CPU prefill of the assistant tool schema takes minutes, not seconds — 60s
# times out before the first token.
AI_ASSISTANT_TIMEOUT_MS=300000
AI_ASSISTANT_TEMPERATURE=0.7
