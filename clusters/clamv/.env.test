# ClamAV cluster configuration
CLAMAV_HOST=clamav-1
CLAMAV_PORT=3310
CLAMAV_IMAGE=clamav/clamav-debian:latest

# Optional ClamAV daemon tuning
FRESHCLAM_CHECKS=12
CLAMD_MAXTHREADS=10
# Largest file clamd scans whole, in MB: at least the largest Maestro MAX_FILE_SIZE of any instance (500 MB by default)
CLAMAV_MAX_FILE_SIZE_MB=500

# Optional host directory to mount for file scanning (leave empty to skip)
# CLAMAV_SCAN_MOUNT=/tmp/scan
